  "components": [
    {
      "name": "顶部七项导航",
      "kind": "nav",
      "refersTo": "navigation-current",
      "description": "七项透明背景导航；72px 金线与文字左边缘对齐，从左向右展开。",
      "html": "<nav class=\"ds-navigation\" aria-label=\"主导航\"><a class=\"ds-nav-current\" href=\"#about-title\" aria-current=\"page\" lang=\"en\"><span class=\"ds-nav-label\">About</span></a><button class=\"ds-nav-item\" type=\"button\" aria-disabled=\"true\" aria-label=\"研究方向，待更新\"><span class=\"ds-nav-label\">研究方向</span></button><button class=\"ds-nav-item\" type=\"button\" aria-disabled=\"true\" aria-label=\"课程作业，待更新\"><span class=\"ds-nav-label\">课程作业</span></button><button class=\"ds-nav-item\" type=\"button\" aria-disabled=\"true\" aria-label=\"爱好，待更新\"><span class=\"ds-nav-label\">爱好</span></button><button class=\"ds-nav-item\" type=\"button\" aria-disabled=\"true\" aria-label=\"活动，待更新\"><span class=\"ds-nav-label\">活动</span></button><button class=\"ds-nav-item\" type=\"button\" aria-disabled=\"true\" aria-label=\"获奖，待更新\"><span class=\"ds-nav-label\">获奖</span></button><a class=\"ds-settings\" href=\"settings.html\"><span class=\"ds-nav-label\">设置</span></a></nav>",
      "css": ".ds-navigation{display:flex;align-items:center;justify-content:space-between;gap:8px;font-family:var(--font-body)}.ds-nav-current,.ds-nav-item,.ds-settings{position:relative;display:inline-flex;align-items:center;justify-content:center;min-width:56px;min-height:42px;padding:7px 13px;border:0;border-radius:var(--radius-control);background:transparent;color:var(--body-ink);font:inherit;line-height:1.5;white-space:nowrap;text-decoration:none;cursor:pointer}.ds-nav-current,.ds-settings{color:var(--gold)}.ds-nav-label::after{content:\"\";position:absolute;left:0;bottom:-7px;width:72px;height:2px;background:var(--gold);transform:scaleX(0);transform-origin:left center;transition:transform .26s cubic-bezier(.16,1,.3,1);pointer-events:none}.ds-navigation>*:hover,.ds-navigation>*:focus-visible{color:var(--gold)}.ds-navigation>*:hover .ds-nav-label::after,.ds-navigation>*:focus-visible .ds-nav-label::after{transform:scaleX(1)}.ds-navigation>*:focus-visible{outline:2px solid var(--gold);outline-offset:4px}@media(max-width:820px){.ds-navigation{justify-content:flex-start;flex-wrap:wrap;gap:4px 9px}}@media(max-width:620px){.ds-navigation{gap:3px 5px}.ds-navigation>*{padding:6px 10px;font-size:.875rem}}@media(prefers-reduced-motion:reduce){.ds-nav-label::after{transition:none}}.ds-nav-label{position:relative;display:inline-block}@media(max-width:1100px){.ds-navigation{padding-inline-end:16px}}"
    },
    {
      "name": "照片占位区域",
      "kind": "custom",
      "refersTo": "portrait-placeholder",
      "description": "照片缺失时的明确占位，保留大幅正方形与实际照片将继承的圆角。",
      "html": "<div class=\"ds-portrait\" role=\"img\" aria-label=\"个人照片待提供\"><div><span class=\"ds-portrait-label\">个人照片</span><span class=\"ds-portrait-note\">待提供</span></div></div>",
      "css": ".ds-portrait{width:min(290px,100%);aspect-ratio:1;margin:0 auto;border-radius:var(--radius-photo);background:var(--portrait-ground);box-shadow:var(--shadow-photo);display:grid;place-content:center;color:#ffffff;text-align:center;font-family:var(--font-body);line-height:1.65}.ds-portrait-label{display:block;font-size:1rem}.ds-portrait-note{display:block;margin-top:4px;color:#e2e8e4;font-size:var(--type-hint)}.ds-portrait img{display:block;width:100%;height:100%;object-fit:cover;border-radius:inherit}@media(max-width:620px){.ds-portrait{width:min(250px,80%)}}"
    },
    {
      "name": "联系图标与名称提示",
      "kind": "button",
      "refersTo": "contact-icon",
      "description": "六个联系入口共用的按钮；示例展示邮箱。悬停或聚焦显示名称，Escape 处理与复制动作由页面脚本提供。",
      "html": "<ul class=\"ds-contacts\" aria-label=\"点击图标复制联系方式\"><li class=\"ds-contact-item\"><button class=\"ds-contact-button\" type=\"button\" data-contact=\"email\" data-label=\"邮箱\" aria-label=\"复制邮箱（资料待提供）\" aria-describedby=\"ds-email-tooltip\"><svg viewBox=\"0 0 22 22\" aria-hidden=\"true\"><rect x=\"2\" y=\"4\" width=\"18\" height=\"14\" rx=\"2\"/><path d=\"m3 6 8 6 8-6\"/></svg></button><span class=\"ds-contact-tooltip\" id=\"ds-email-tooltip\" role=\"tooltip\"><span>邮箱</span></span></li></ul>",
      "css": ".ds-contacts{list-style:none;padding:0;margin:22px 0 0;display:flex;justify-content:center;align-items:center;gap:10px;font-family:var(--font-body)}.ds-contact-item{position:relative}.ds-contact-button{width:36px;height:36px;display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:var(--radius-control);background:transparent;color:#53606d;cursor:pointer}.ds-contact-button:hover,.ds-contact-button:focus-visible{color:var(--gold);background:var(--gold-soft)}.ds-contact-button:focus-visible{outline:2px solid var(--gold);outline-offset:4px}.ds-contact-button svg{width:21px;height:21px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}.ds-contact-tooltip{position:absolute;z-index:6;bottom:100%;left:50%;transform:translateX(-50%);padding-bottom:5px;color:var(--gold);font-size:var(--type-hint);line-height:1.5;white-space:nowrap;visibility:hidden}.ds-contact-tooltip span{display:block;padding:5px 9px;border-radius:var(--radius-control);background:var(--gold-soft);box-shadow:var(--shadow-card)}.ds-contact-item:not(.ds-tooltip-dismissed):hover .ds-contact-tooltip,.ds-contact-item:not(.ds-tooltip-dismissed):focus-within .ds-contact-tooltip{visibility:visible}@media(max-width:1100px){.ds-contacts{gap:5px}}@media(max-width:820px){.ds-contacts{gap:0}.ds-contact-button{width:32px}}@media(max-width:620px){.ds-contacts{gap:10px;margin-top:18px}.ds-contact-button{width:36px}}@media(max-width:360px){.ds-contacts{gap:7px}}"
    },
    {
      "name": "新增 News 入口",
      "kind": "button",
      "refersTo": "news-add",
      "description": "紧邻 News 标题的 40px 金色加号链接，进入独立 News 新增页。",
      "html": "<a class=\"ds-news-add\" href=\"news-edit.html\" aria-label=\"新增 News\" title=\"新增 News\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M12 5v14M5 12h14\"/></svg></a>",
      "css": ".ds-news-add{flex:none;width:40px;height:40px;display:inline-flex;align-items:center;justify-content:center;border-radius:var(--radius-control);color:var(--gold);text-decoration:none}.ds-news-add:hover,.ds-news-add:focus-visible{background:var(--gold-soft)}.ds-news-add:focus-visible{outline:2px solid var(--gold);outline-offset:4px}.ds-news-add svg{width:21px;height:21px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round}"
    },
    {
      "name": "动态卡片",
      "kind": "card",
      "refersTo": "news-card",
      "description": "日期与普通字重正文，无标题；可选右侧缩略图与正文下的文件下载链接。",
      "html": "<article class=\"ds-news-card\"><div class=\"ds-news-text\"><span class=\"ds-news-date\">日期待补充</span><p class=\"ds-news-copy\">动态内容待补充</p></div></article>",
      "css": ".ds-news-card{display:flex;align-items:flex-start;gap:24px;padding:19px 20px 20px;border-radius:var(--radius-card);background:var(--card);box-shadow:var(--shadow-card);overflow-wrap:anywhere;font-family:var(--font-body)}.ds-news-text{flex:1;min-width:0}.ds-news-date{display:block;margin-bottom:7px;color:var(--gold);font-size:var(--type-meta);line-height:1.5;font-variant-numeric:lining-nums tabular-nums}.ds-news-copy{margin:0;color:var(--body-ink);font-size:var(--type-body);line-height:1.7;white-space:pre-wrap;text-wrap:pretty}.ds-news-image{flex:none;width:144px;max-width:32%;height:auto;aspect-ratio:4/3;object-fit:contain;border-radius:var(--radius-control)}.ds-news-file{display:inline-flex;min-height:28px;max-width:100%;margin-top:10px;color:var(--gold);font-size:var(--type-meta);text-decoration:none}.ds-news-file:hover{text-decoration:underline}@media(max-width:620px){.ds-news-card{gap:14px;padding:17px 18px}.ds-news-copy{font-size:1rem}.ds-news-image{width:96px}}"
    },
    {
      "name": "手动复制恢复面板",
      "kind": "input",
      "refersTo": "copy-recovery",
      "description": "复制失败后的常驻恢复界面；片段展示面板内部。页面负责底部固定定位、填入实际值、全选及关闭后恢复焦点。",
      "html": "<div class=\"ds-copy-recovery\" role=\"region\" aria-labelledby=\"ds-copy-recovery-label\"><label id=\"ds-copy-recovery-label\" for=\"ds-copy-value\">无法自动复制，请选择内容后手动复制</label><div class=\"ds-recovery-row\"><input id=\"ds-copy-value\" type=\"text\" readonly><button class=\"ds-recovery-close\" type=\"button\">关闭</button></div></div>",
      "css": ".ds-copy-recovery{width:min(440px,calc(100% - 32px));padding:18px;border-radius:var(--radius-card);background:var(--paper);box-shadow:0 5px 28px rgba(30,39,48,.22);font-family:var(--font-body);font-size:var(--type-meta);line-height:1.65}.ds-copy-recovery label{display:block;margin-bottom:10px;color:var(--ink);font-weight:600}.ds-recovery-row{display:flex;gap:8px}.ds-copy-recovery input{min-width:0;width:100%;padding:8px 10px;border:1px solid var(--line);border-radius:var(--radius-control);color:var(--body-ink);caret-color:var(--gold);font:inherit}.ds-recovery-close{flex:none;padding:8px 12px;border:0;border-radius:var(--radius-control);background:var(--gold-soft);color:var(--gold);cursor:pointer;font:inherit}.ds-copy-recovery input:focus-visible,.ds-recovery-close:focus-visible{outline:2px solid var(--gold);outline-offset:4px}"
    },
    {
      "name": "普通状态提示",
      "kind": "custom",
      "refersTo": "status-toast",
      "description": "底部短时状态反馈的可见状态；片段保留内容样式，页面负责视窗居中、显示时长与进出状态。",
      "html": "<div class=\"ds-status-toast\" role=\"status\" aria-live=\"polite\" aria-atomic=\"true\">邮箱待提供</div>",
      "css": ".ds-status-toast{width:max-content;max-width:calc(100% - 32px);padding:11px 18px;border-radius:var(--radius-control);background:var(--ink);color:var(--paper);font-family:var(--font-body);font-size:var(--type-meta);line-height:1.6;overflow-wrap:anywhere;opacity:1;pointer-events:none;transition:opacity .16s ease-out,transform .16s ease-out}@media(prefers-reduced-motion:reduce){.ds-status-toast{transition:none}}"
    },
    {
      "name": "简历入口",
      "kind": "button",
      "refersTo": "cv-button",
      "description": "浅金底、金色文字；未保存 PDF 时禁用，保存本机 PDF 后启用下载，宽度始终与照片一致。",
      "html": "<button class=\"ds-cv\" disabled>简历待上传</button>",
      "css": ".ds-cv { width:min(290px,100%); display:inline-flex; align-items:center; justify-content:center; min-height:40px; padding:8px 22px; border:0; border-radius:var(--radius-control); background:var(--gold-soft); color:var(--gold); font:400 var(--type-meta)/1.6 var(--font-body); cursor:not-allowed; } .ds-cv:focus-visible { outline:2px solid var(--gold); outline-offset:4px; } .ds-cv:not(:disabled){cursor:pointer}.ds-cv:not(:disabled):hover{box-shadow:inset 0 0 0 1px var(--gold)}"
    },
    {
      "name": "基本信息输入框",
      "kind": "input",
      "refersTo": "settings-input",
      "description": "四组资料表单；普通字段桌面双列、820px 以下单列；About 使用独立全宽富文本组件。",
      "html": "<label class=\"ds-label\" for=\"ds-name\">姓名</label><input class=\"ds-editor-input\" id=\"ds-name\" type=\"text\" placeholder=\"请输入姓名\">",
      "css": ".ds-label { display:block; margin-bottom:10px; color:var(--ink); font:600 1rem/1.65 var(--font-body); } .ds-editor-input { box-sizing:border-box; width:100%; min-height:52px; padding:12px 16px; border:1px solid var(--line); border-radius:12px; background:var(--paper); color:var(--ink); font:400 1rem/1.65 var(--font-body); } .ds-editor-input::placeholder { color:var(--muted); } .ds-editor-input:focus { border-color:var(--gold); outline:2px solid var(--gold-soft); outline-offset:2px; } .ds-editor-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;max-width:820px}.ds-editor-input{min-width:0;caret-color:var(--gold)}@media(max-width:820px){.ds-editor-fields{grid-template-columns:1fr}}"
    },
    {
      "name": "保存按钮",
      "kind": "button",
      "refersTo": "settings-save",
      "description": "保存全部资料并返回；文件读取期间禁用，失败保留输入。",
      "html": "<button class=\"ds-save\" type=\"button\">保存</button>",
      "css": ".ds-save { min-height:44px; min-width:112px; padding:10px 25px; border:0; border-radius:var(--radius-control); background:var(--gold-soft); color:var(--gold); font:600 1rem/1.65 var(--font-body); cursor:pointer; } .ds-save:hover { box-shadow:inset 0 0 0 1px var(--gold); } .ds-save:focus-visible { outline:2px solid var(--gold); outline-offset:4px; } .ds-save:disabled{opacity:.6;cursor:wait}"
    },
    {
      "name": "文件选择与移除",
      "kind": "input",
      "refersTo": "settings-input",
      "description": "照片预览为96px方形；原生文件选择、可换行文件名、金色移除操作。只保存到当前浏览器。",
      "html": "<label class=\"ds-label\" for=\"ds-photo\">个人照片</label><input class=\"ds-editor-file\" id=\"ds-photo\" type=\"file\" accept=\"image/jpeg,image/png,image/webp\"><p>JPG、PNG 或 WebP，不超过 1 MB。</p>",
      "css": ".ds-editor-file{box-sizing:border-box;width:100%;min-width:0;min-height:52px;padding:8px;border:1px solid var(--line);border-radius:12px;color:var(--ink);background:var(--paper);font:400 .875rem/1.65 var(--font-body)}.ds-editor-file::file-selector-button{margin-right:12px;padding:7px 12px;border:0;border-radius:var(--radius-control);background:var(--gold-soft);color:var(--gold);font:inherit;cursor:pointer}"
    },
    {
      "name": "About 富文本编辑器",
      "kind": "custom",
      "refersTo": "about-editor",
      "description": "About 全宽编辑区；选词加粗、金色、自选文字颜色和清除格式，保留旧文字与换行。",
      "html": "<div class=\"ds-rich-shell\"><div class=\"ds-rich-toolbar\" role=\"group\" aria-label=\"About 文字格式\"><button type=\"button\" aria-pressed=\"false\">加粗</button><button type=\"button\">金色</button><label>文字颜色 <input type=\"color\" value=\"#866b35\"></label><button type=\"button\">清除格式</button></div><div class=\"ds-rich-editor\" role=\"textbox\" aria-label=\"About 内容\" aria-multiline=\"true\" contenteditable=\"true\">在这里填写 About 全文。</div></div>",
      "css": ".ds-rich-shell{border:1px solid var(--line);border-radius:12px;overflow:hidden}.ds-rich-shell:focus-within{border-color:var(--gold)}.ds-rich-toolbar{display:flex;align-items:center;flex-wrap:wrap;gap:4px 8px;padding:8px 12px;border-bottom:1px solid var(--line)}.ds-rich-toolbar button{min-height:36px;padding:5px 10px;border:0;border-radius:var(--radius-control);background:transparent;color:var(--body-ink);font:inherit;cursor:pointer}.ds-rich-toolbar button:hover,.ds-rich-toolbar button[aria-pressed=true]{background:var(--gold-soft);color:var(--gold)}.ds-rich-editor{min-height:280px;padding:14px 16px;color:var(--body-ink);caret-color:var(--gold);white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.8;font-family:var(--font-body)}.ds-rich-editor:focus{outline:2px solid var(--gold-soft);outline-offset:-2px}"
    },
    {
      "name": "About 展开与收起",
      "kind": "button",
      "refersTo": "about-toggle",
