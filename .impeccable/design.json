      "css": ".ds-news-actions{display:flex;align-items:center;gap:4px;opacity:0;pointer-events:none}.ds-news-card:hover .ds-news-actions,.ds-news-card:focus-within .ds-news-actions{opacity:1;pointer-events:auto}.ds-news-action{display:inline-flex;align-items:center;justify-content:center;min-height:32px;padding:3px 8px;border:0;border-radius:var(--radius-control);background:transparent;color:var(--gold);font-size:var(--type-meta);line-height:1.5;text-decoration:none;cursor:pointer}.ds-news-action:hover,.ds-news-action:focus-visible{background:var(--gold-soft)}.ds-news-action:focus-visible{outline:2px solid var(--gold);outline-offset:4px}.ds-news-delete{color:var(--error)}@media(hover:none),(pointer:coarse){.ds-news-actions{opacity:1;pointer-events:auto}.ds-news-action{min-height:40px}}"
